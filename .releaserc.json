{
  "branches": [
    "main"
  ],
  "tagFormat": "${version}",
  "preset": "conventionalcommits",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "test",
            "release": false
          },
          {
            "type": "ci",
            "release": false
          },
          {
            "breaking": true,
            "release": "major"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "Nuove funzionalit\u00e0"
            },
            {
              "type": "fix",
              "section": "Bug fix"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "refactor",
              "section": "Refactoring"
            },
            {
              "type": "test",
              "section": "Test",
              "hidden": true
            },
            {
              "type": "chore",
              "section": "Chore",
              "hidden": true
            },
            {
              "type": "docs",
              "section": "Docs",
              "hidden": true
            },
            {
              "type": "ci",
              "section": "CI/CD",
              "hidden": true
            }
          ]
        }
      }
    ],
    "@semantic-release/github"
  ]
}
