    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "knex": "^3.1.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.19.0",
